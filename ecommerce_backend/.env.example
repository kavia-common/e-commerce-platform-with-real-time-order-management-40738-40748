# Database connection URL
# Examples:
#   Postgres: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
#   MySQL: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
#   SQLite (local dev): sqlite:///./app.db
DATABASE_URL=sqlite:///./app.db

# JWT secret used for signing local tokens (do not commit the real secret)
JWT_SECRET=change_me

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins - comma separated
# Example: http://localhost:3000,https://your-frontend.app
ALLOW_ORIGINS=http://localhost:3000

# Optional Supabase integration
# If provided, backend will also accept tokens signed with this secret
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Backend environment variables

# Database connection string
# Default local Postgres from ecommerce_database container instructions:
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT configuration
# Change JWT_SECRET in real deployments
JWT_SECRET=dev_jwt_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins - ensure frontend (port 3000) is present
ALLOW_ORIGINS=http://localhost:3000

# Optional: Supabase integration (used for optional JWT verification)
# If set, backend can verify tokens signed by Supabase
SUPABASE_URL=
SUPABASE_JWT_SECRET=
